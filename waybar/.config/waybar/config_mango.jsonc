// -*- mode: jsonc -*-
{
  "layer": "top",
  "margin-top": 2,
  "margin-bottom": 2,
  "margin-left": 12,
  "margin-right": 12,
  "height": 24,
  "spacing": 18,
  "modules-left": [
    "custom/launcher",
    "ext/workspaces"
  ],
  "modules-center": [
    "group/date-time",
  ],
  "modules-right": [
    "cpu",
    "memory",
    "battery",
    "power-profiles-daemon",
    "network",
    "bluetooth",
    "pulseaudio",
    "tray",
    "custom/power"
  ],
  "custom/launcher": {
    "format": "󰣇",
    "tooltip": false,
    "on-click": "rofi -show drun"
  },
  "ext/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "on-click-right": "deactivate"
  },
  "tray": {
    "spacing": 12,
  },
  "clock#date": {
    "format": " {:%a, %d/%m/%y}",
    "timezone": "Asia/Ho_Chi_Minh",
    "format-alt": "{calendar}",
    "tooltip-format": "{calendar}"
  },
  "clock#time": {
    "format": " {:%H:%M}",
    "timezone": "Asia/Ho_Chi_Minh"
  },
  "group/date-time": {
    "orientation": "horizontal",
    "modules": [
      "clock#time",
      "clock#date"
    ]
  },
  "cpu": {
    "format": " {usage}%",
    "tooltip": false,
    "states": {
      "warning": 70,
      "critical": 95
    }
  },
  "memory": {
    "format": " {used:0.1f}G",
    "tooltip": false,
    "states": {
      "warning": 70,
      "critical": 95,
    }
  },
  "battery": {
    "states": {
      "good": 100,
      "warning": 25,
      "critical": 10
    },
    "format": "{icon} {capacity}% ",
    "format-full": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{icon} {time}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "on-update": "~/.config/waybar/scripts/check_battery.sh"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "bluetooth": {
    "format": "{icon}",
    "format-icons": {
      "on": "",
      "off": "󰂲",
      "connected": "󰂱",
      "disabled": "󰂲"
    },
    "tooltip-format-connected": "{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%",
    "on-click": "~/.config/hypr/scripts/launch_bluetui.sh"
  },
  "network": {
    "interface": "wlan0",
    "format-wifi": "󱚽",
    "format-ethernet": "",
    "tooltip-format": "{essid} ({signalStrength}%)",
    "format-linked": "󱚸",
    "format-disconnected": "󱛅",
    "format-disabled": "󰖪",
    "on-click": "~/.config/hypr/scripts/launch_wifitui.sh"
  },
  "pulseaudio": {
    "format": "{icon}",
    // "format-bluetooth": "{icon} {volume}%",
    "format-bluetooth-muted": "",
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "~/.config/hypr/scripts/launch_wiremix.sh"
  },
  "custom/power": {
    "icon-size": 21,
    "format": "⏻",
    "tooltip": false,
    "on-click": "~/.config/rofi/powermenu.sh"
  }
}
